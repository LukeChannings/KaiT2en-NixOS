[
  { "label": "Build", "command": "just", "args": ["build"] },
  { "label": "Lint", "command": "just", "args": ["lint"] },
  { "label": "Format", "command": "just", "args": ["format"] },
  { "label": "Test", "command": "just", "args": ["test"] },
  {
