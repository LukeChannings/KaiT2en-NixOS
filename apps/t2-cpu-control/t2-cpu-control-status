#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == monitor ]]; then
    [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "usage: $0 monitor <gui-pid>" >&2; exit 2; }
    gui_pid=$2
    state_dir=/run/t2-cpu-control
    cache=$state_dir/status
    temporary=$state_dir/status.tmp
    install -d -m 0755 "$state_dir"
    rm -f "$cache" "$temporary"
    trap 'rm -f "$temporary"' EXIT
    while kill -0 "$gui_pid" 2>/dev/null; do
        "$0" >"$temporary"
        chmod 0644 "$temporary"
        mv -f "$temporary" "$cache"
        sleep 0.1
    done
fi

modprobe msr
zone=
for z in /sys/class/powercap/intel-rapl:*; do
    [[ -r "$z/name" && $(<"$z/name") == package-* ]] && { zone=$z; break; }
done
[[ -n $zone ]] || { echo error=Intel_RAPL_unavailable; exit 1; }
for f in "$zone"/constraint_*_name; do
    [[ -r "$f" ]] || continue
    case $(<"$f") in
        long_term) long=${f%_name} ;;
        short_term) short=${f%_name} ;;
    esac
done
[[ -n ${long:-} && -n ${short:-} ]] || { echo error=RAPL_constraints_unavailable; exit 1; }

unit=$((16#$(rdmsr -p 0 0x606)))
power_div=$((1 << (unit & 15)))
tdp=$(rdmsr -p 0 0x614 2>/dev/null || echo 0)
tdp=$((16#$tdp))
tdp_uw=$(( (tdp & 0x7fff) * 1000000 / power_div ))
((tdp_uw > 0)) || tdp_uw=$(<"${long}_max_power_uw")

nominal_hex=$(rdmsr -p 0 0x648 2>/dev/null || echo 0)
nominal=$((16#$nominal_hex & 0xff))
base_uw=$tdp_uw
base_kind=package-tdp
down_ratio=255
for msr in 0x649 0x64a; do
    level_hex=$(rdmsr -p 0 "$msr" 2>/dev/null || echo 0)
    level=$((16#$level_hex))
    level_power=$((level & 0x7fff))
    level_ratio=$(((level >> 16) & 0xff))
    if ((level_power > 0 && level_ratio > 0 && level_ratio < nominal && level_ratio < down_ratio)); then
        base_uw=$((level_power * 1000000 / power_div))
        base_kind=ctdp-down
        down_ratio=$level_ratio
    fi
done

max_power_uw=$((((tdp >> 32) & 0x7fff) * 1000000 / power_div))
((max_power_uw > 0)) || max_power_uw=$((tdp_uw * 2))
ceiling_uw=$max_power_uw
((ceiling_uw >= base_uw + 10000000)) || ceiling_uw=$((base_uw + 10000000))

printf 'model=%s\n' "$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)"
printf 'pl1_uw=%s\npl2_uw=%s\nbase_uw=%s\nbase_kind=%s\ntdp_uw=%s\nceiling_uw=%s\n' \
    "$(<"${long}_power_limit_uw")" "$(<"${short}_power_limit_uw")" \
    "$base_uw" "$base_kind" "$tdp_uw" "$ceiling_uw"
enabled=0
if [[ -r /etc/t2-cpu-control.conf ]]; then
    saved_enabled=$(sed -n 's/^enabled=//p' /etc/t2-cpu-control.conf | tail -1)
    [[ $saved_enabled == 1 ]] && enabled=1
fi
printf 'persistent=%s\n' "$enabled"
no_turbo=0
[[ -r /sys/devices/system/cpu/intel_pstate/no_turbo ]] && \
    no_turbo=$(</sys/devices/system/cpu/intel_pstate/no_turbo)
printf 'no_turbo=%s\n' "$no_turbo"
freq_min_khz=0; freq_max_khz=0; max_freq_khz=0; freq_policy_count=0; freq_writable=1
for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do
    [[ -r $f ]] || continue
    freq_policy_count=$((freq_policy_count + 1))
    policy=${f%/scaling_max_freq}
    policy_min=$(<"$policy/cpuinfo_min_freq")
    policy_max=$(<"$policy/cpuinfo_max_freq")
    policy_current=$(<"$f")
    ((policy_min <= freq_min_khz)) || freq_min_khz=$policy_min
    ((freq_max_khz != 0 && freq_max_khz <= policy_max)) || freq_max_khz=$policy_max
    ((max_freq_khz != 0 && max_freq_khz <= policy_current)) || max_freq_khz=$policy_current
    [[ -w $f ]] || freq_writable=0
done
((freq_policy_count > 0)) || freq_writable=0
freq_min_khz=$(( ((freq_min_khz + 99999) / 100000) * 100000 ))
freq_max_khz=$(( (freq_max_khz / 100000) * 100000 ))
((freq_min_khz <= freq_max_khz)) || freq_writable=0
printf 'freq_min_khz=%s\nfreq_max_khz=%s\nmax_freq_khz=%s\nfreq_writable=%s\n' \
    "$freq_min_khz" "$freq_max_khz" "$max_freq_khz" "$freq_writable"
if [[ -r /run/t2-cpu-control/firmware-defaults ]]; then
    defaults_pl1_uw=$(sed -n 's/^pl1_uw=//p' /run/t2-cpu-control/firmware-defaults)
    defaults_pl2_uw=$(sed -n 's/^pl2_uw=//p' /run/t2-cpu-control/firmware-defaults)
    defaults_no_turbo=$(sed -n 's/^no_turbo=//p' /run/t2-cpu-control/firmware-defaults)
    defaults_tcc_offset=$(sed -n 's/^tcc_offset=//p' /run/t2-cpu-control/firmware-defaults)
    defaults_max_freq_khz=$(sed -n 's/^max_freq_khz=//p' /run/t2-cpu-control/firmware-defaults)
    printf 'defaults_pl1_uw=%s\ndefaults_pl2_uw=%s\ndefaults_no_turbo=%s\ndefaults_tcc_offset=%s\ndefaults_max_freq_khz=%s\n' \
        "$defaults_pl1_uw" "$defaults_pl2_uw" "${defaults_no_turbo:-0}" "${defaults_tcc_offset:-0}" "$defaults_max_freq_khz"
fi
printf 'energy_uj=%s\n' "$(<"$zone/energy_uj")"
printf 'max_energy_uj=%s\n' "$(<"$zone/max_energy_range_uj")"

target=$((16#$(rdmsr -p 0 0x1a2)))
tjmax=$(((target >> 16) & 255)); offset=$(((target >> 24) & 0x3f))
platform_info=$((16#$(rdmsr -p 0 0xce 2>/dev/null || echo 0)))
printf 'tjmax=%s\ntcc_offset=%s\ntcc_target=%s\ntcc_locked=%s\ntcc_programmable=%s\n' \
    "$tjmax" "$offset" "$((tjmax - offset))" "$(((target >> 31) & 1))" "$(((platform_info >> 30) & 1))"
printf 'defaults_tcc_target=%s\n' "$((tjmax - ${defaults_tcc_offset:-0}))"
power_ctl=$((16#$(rdmsr -p 0 0x1fc)))
printf 'prochot_override=%s\n' "$(((power_ctl & 1) == 0))"
package_therm_hex=$(rdmsr -p 0 0x1b1 2>/dev/null || echo 0)
package_therm=$((16#$package_therm_hex))
package_dtj=$(((package_therm >> 16) & 127))
if ((package_therm & (1 << 31))); then
    printf 'package_temp=%s\n' "$((tjmax - package_dtj))"
fi
perf_active=0; perf_log=0; any_prochot=0; any_thermal=0; min_dtj=127
count=$(nproc)
for ((cpu=0; cpu<count; cpu++)); do
    therm=$((16#$(rdmsr -p "$cpu" 0x19c)))
    perf_hex=$(rdmsr -p "$cpu" 0x64f 2>/dev/null || echo 0); perf=$((16#$perf_hex))
    dtj=$(((therm >> 16) & 127)); temp=$((tjmax - dtj))
    mhz=$(cat "/sys/devices/system/cpu/cpu$cpu/cpufreq/scaling_cur_freq" 2>/dev/null || echo 0)
    mhz=$((mhz / 1000))
    thermal=$((therm & 1)); prochot=$(((therm >> 2) & 1))
    printf 'cpu.%s=%s,%s,%s,%s\n' "$cpu" "$mhz" "$temp" "$thermal" "$prochot"
    ((dtj < min_dtj)) && min_dtj=$dtj
    if ((thermal)); then any_thermal=1; fi
    if ((prochot)); then any_prochot=1; fi
    perf_active=$((perf_active | (perf & 0xffff)))
    perf_log=$((perf_log | ((perf >> 16) & 0xffff)))
done
if ((perf_active & 1)); then any_prochot=1; fi
bd=0
if ((any_prochot && !any_thermal && min_dtj > offset)); then bd=1; fi
printf 'prochot=%s\nthermal=%s\nbd_inferred=%s\nperf_active=%s\nperf_log=%s\n' \
    "$any_prochot" "$any_thermal" "$bd" "$perf_active" "$perf_log"
