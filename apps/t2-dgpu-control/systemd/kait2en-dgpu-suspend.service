[Unit]
Description=Keep an intentionally powered-off dGPU suspendable
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/local/libexec/t2-dgpu-control-helper prepare-suspend
ExecStop=-/usr/local/libexec/t2-dgpu-control-helper restore-after-resume

[Install]
WantedBy=sleep.target
