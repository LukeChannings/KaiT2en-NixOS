# NixOS module for upstream's t2-services/: the bridgeOS services reached over
# the T2's internal CDC-NCM link (05ac:8233), and their shared integration.
#
# ── shared (services.t2-services) ──────────────────────────────────────────
# Mirrors t2-services/shared (Makefile `install` + install-t2-services-common.sh):
#   * NetworkManager: conf.d/10-t2-services.conf (`no-auto-default` for the
#     fixed T2 NCM MAC, so NM stops spawning duplicate wired profiles) and the
#     "Apple T2 Bridge" profile from integration/NetworkManager/
#     t2-ncm.nmconnection (IPv6 link-local only — the services talk to bridgeOS
#     over it). This replaces the old t2-ncm `NM_UNMANAGED` udev rule, which
#     upstream deletes: an unmanaged link has no link-local address, so
#     t2remote/t2-touchid/t2journal could not reach the T2.
#   * t2-services-suspend.service (integration/systemd/
#     t2-services-suspend.service): runs integration/libexec/t2-ncm-sleep
#     pre/post around sleep, which runs every feature's sleep.d hook. Upstream
#     installs hooks into $LIBEXECDIR/t2-services/sleep.d; here the hook dir is
#     a store linkFarm of the enabled features' hooks, passed via T2_HOOK_DIR.
#   * The Fedora lifecycle/migration helpers (packaging/lifecycle,
#     integration/migration, integration/libexec/package-actions) are
#     installer bookkeeping and not consumed.
#
# ── t2-ave (services.t2-ave) ───────────────────────────────────────────────
# kait2en-t2-remote.service (t2-services/t2-ave/integration/systemd): loads
# t2bce_ave and runs `t2remote daemon`; its suspend hook joins sleep.d.
#
# ── t2-touchid (services.t2-touchid) ───────────────────────────────────────
# kait2en-t2-touchid.service, the fprintd.service drop-in
# (integration/fprintd/fprintd-kait2en-t2-touchid.conf), the D-Bus policy and
# /etc/kait2en/t2-touchid.conf (generated from options). fprintd itself comes
# from services.fprintd, whose PAM integration replaces the installer's
# "enable-pam" step. The SELinux policy is Fedora-only.
#
# ── t2-journal (services.t2-journal) ───────────────────────────────────────
# The `t2journal` CLI only; it has no system integration beyond the link.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.services.t2-services;
  aveCfg = config.services.t2-ave;
  touchidCfg = config.services.t2-touchid;
  journalCfg = config.services.t2-journal;

  sharedSrc = ../../../t2-services/shared/integration;

  ncmSleep =
    pkgs.runCommand "t2-ncm-sleep"
      {
        nativeBuildInputs = [ pkgs.makeWrapper ];
        buildInputs = [ pkgs.bash ];
      }
      ''
        install -Dm755 ${sharedSrc + "/libexec/t2-ncm-sleep"} "$out/bin/t2-ncm-sleep"
        patchShebangs "$out/bin/t2-ncm-sleep"
        wrapProgram "$out/bin/t2-ncm-sleep" \
          --prefix PATH : ${lib.makeBinPath [ pkgs.coreutils ]}
      '';

  # Upstream installs each feature's hook into $LIBEXECDIR/t2-services/sleep.d.
  hookDir = pkgs.linkFarm "t2-services-sleep.d" (
    lib.optional aveCfg.enable {
      name = "t2-ave";
      path = "${aveCfg.package}/libexec/t2-services/sleep.d/t2-ave";
    }
  );

  touchidConfig = pkgs.writeText "t2-touchid.conf" ''
    # Generated by nix/modules/t2-services from services.t2-touchid.
    T2_TOUCHID_UID=${touchidCfg.uid}
    T2_TOUCHID_FLAGS=${toString touchidCfg.flags}
    T2_TOUCHID_BIND_USER=${touchidCfg.bindUser}
    T2_TOUCHID_SOCKET=/run/t2-touchid/fprint.sock
  '';
in
{
  imports = [
    (lib.mkRenamedOptionModule [ "services" "t2-ncm" "enable" ] [ "services" "t2-services" "enable" ])
  ];

  options = {
    services.t2-services = {
      enable = lib.mkEnableOption ''
        the shared T2 bridge-link integration: the NetworkManager
        "Apple T2 Bridge" link-local profile for the internal CDC-NCM
        interface and the t2-services suspend/resume hook runner'';

      manageNetworkProfile = lib.mkOption {
        type = lib.types.bool;
        default = config.networking.networkmanager.enable;
        defaultText = lib.literalExpression "config.networking.networkmanager.enable";
        description = ''
          Provision the NetworkManager `no-auto-default` drop-in and the
          declarative "Apple T2 Bridge" profile (IPv6 link-local on the T2 NCM
          MAC ac:de:48:00:11:22). Without NetworkManager you must bring that
          link up with an IPv6 link-local address yourself.
        '';
      };
    };

    services.t2-ave = {
      enable = lib.mkEnableOption "the T2 AVE (Apple Video Encoder) service, `t2remote`";
      package = lib.mkOption {
        type = lib.types.package;
        default = pkgs.callPackage ../../../t2-services/t2-ave/package.nix { };
        defaultText = lib.literalExpression "pkgs.callPackage ../../../t2-services/t2-ave/package.nix { }";
        description = "The t2-ave package providing `t2remote`.";
      };
    };

    services.t2-touchid = {
      enable = lib.mkEnableOption "the T2 Touch ID bridge for fprintd (login/sudo with the finger enrolled in macOS)";
      package = lib.mkOption {
        type = lib.types.package;
        default = pkgs.callPackage ../../../t2-services/t2-touchid/package.nix { };
        defaultText = lib.literalExpression "pkgs.callPackage ../../../t2-services/t2-touchid/package.nix { }";
        description = "The t2-touchid package.";
      };
      bindUser = lib.mkOption {
        type = lib.types.str;
        default = "none";
        example = "alice";
        description = ''
          Linux account the macOS-enrolled fingers are bound to automatically
          (`T2_TOUCHID_BIND_USER`; upstream's installer sets it to the invoking
          user). `"none"` leaves binding to a manual `fprintd-enroll`.
        '';
      };
      uid = lib.mkOption {
        type = lib.types.str;
        default = "auto";
        description = ''
          The *macOS* user id whose enrolled fingers to verify against
          (`T2_TOUCHID_UID`). `"auto"` finds the one with Touch ID enrolled; set
          a number (501 and up) only if several macOS users have Touch ID.
        '';
      };
      flags = lib.mkOption {
        type = lib.types.int;
        default = 0;
        description = "BiometricKit match flags (`T2_TOUCHID_FLAGS`); 0 = plain verify.";
      };
    };

    services.t2-journal = {
      enable = lib.mkEnableOption "the T2 bridgeOS log reader, `t2journal`";
      package = lib.mkOption {
        type = lib.types.package;
        default = pkgs.callPackage ../../../t2-services/t2-journal/package.nix { };
        defaultText = lib.literalExpression "pkgs.callPackage ../../../t2-services/t2-journal/package.nix { }";
        description = "The t2-journal package providing `t2journal`.";
      };
    };
  };

  config = lib.mkMerge [
    {
      # Both services reach bridgeOS over the shared link.
      services.t2-services.enable = lib.mkIf (aveCfg.enable || touchidCfg.enable || journalCfg.enable) (
        lib.mkDefault true
      );
    }

    (lib.mkIf cfg.enable {
      environment.etc."NetworkManager/conf.d/10-t2-services.conf" = lib.mkIf cfg.manageNetworkProfile {
        source = sharedSrc + "/NetworkManager/10-t2-services.conf";
      };

      # integration/NetworkManager/t2-ncm.nmconnection.
      networking.networkmanager.ensureProfiles.profiles = lib.mkIf cfg.manageNetworkProfile {
        t2-ncm = {
          connection = {
            id = "Apple T2 Bridge";
            uuid = "6ab6bd67-a58f-47a6-a7c5-b03c2de64f2b";
            type = "ethernet";
            autoconnect = "true";
            autoconnect-retries = "0";
          };
          ethernet.mac-address = "AC:DE:48:00:11:22";
          ipv4.method = "disabled";
          ipv6.method = "link-local";
        };
      };

      # Mirrors integration/systemd/t2-services-suspend.service.
      systemd.services.t2-services-suspend = {
        description = "T2 service link suspend and resume";
        before = [ "sleep.target" ];
        after = [ "NetworkManager.service" ];
        wantedBy = [ "sleep.target" ];
        unitConfig.StopWhenUnneeded = true;
        environment.T2_HOOK_DIR = "${hookDir}";
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          TimeoutStartSec = 180;
          TimeoutStopSec = 300;
          ExecStart = "${ncmSleep}/bin/t2-ncm-sleep pre";
          ExecStop = "${ncmSleep}/bin/t2-ncm-sleep post";
        };
      };
    })

    (lib.mkIf aveCfg.enable {
      environment.systemPackages = [ aveCfg.package ];

      # Mirrors t2-services/t2-ave/integration/systemd/kait2en-t2-remote.service.
      systemd.services.kait2en-t2-remote = {
        description = "KaiT2en T2 AVE service";
        after = [
          "NetworkManager.service"
          "network-online.target"
        ];
        wants = [
          "NetworkManager.service"
          "network-online.target"
        ];
        wantedBy = [ "multi-user.target" ];
        serviceConfig = {
          Type = "simple";
          ExecStartPre = "${pkgs.kmod}/bin/modprobe t2bce_ave";
          ExecStart = "${lib.getExe aveCfg.package} daemon";
          Restart = "on-failure";
          RestartSec = 2;
          UMask = "0007";
          Group = "root";
        };
      };
    })

    (lib.mkIf journalCfg.enable {
      environment.systemPackages = [ journalCfg.package ];
    })

    (lib.mkIf touchidCfg.enable {
      environment.systemPackages = [ touchidCfg.package ];

      environment.etc."kait2en/t2-touchid.conf".source = touchidConfig;

      services.dbus.packages = [ touchidCfg.package ];

      services.fprintd.enable = true;

      # Mirrors t2-services/t2-touchid/integration/systemd/kait2en-t2-touchid.service.
      systemd.services.kait2en-t2-touchid = {
        description = "KaiT2en Touch ID bridge for fprintd";
        after = [
          "NetworkManager.service"
          "network-online.target"
        ];
        wants = [
          "NetworkManager.service"
          "network-online.target"
        ];
        wantedBy = [ "multi-user.target" ];
        restartTriggers = [ touchidConfig ];
        serviceConfig = {
          Type = "simple";
          EnvironmentFile = "/etc/kait2en/t2-touchid.conf";
          ExecStart = "${lib.getExe touchidCfg.package} --socket \${T2_TOUCHID_SOCKET} --uid \${T2_TOUCHID_UID} --flags \${T2_TOUCHID_FLAGS} --bind-user \${T2_TOUCHID_BIND_USER}";
          Restart = "on-failure";
          RestartSec = 5;

          RuntimeDirectory = "t2-touchid";
          RuntimeDirectoryMode = "0700";
          RuntimeDirectoryPreserve = true;
          NoNewPrivileges = true;
          ProtectSystem = "strict";
          ProtectHome = true;
          PrivateTmp = true;
        };
      };

      # Mirrors integration/fprintd/fprintd-kait2en-t2-touchid.conf: point
      # fprintd at libfprint's virtual storage device (the bridge's socket) and
      # tie it to the bridge, so a stopped bridge means "no reader" and PAM
      # falls straight through to the password.
      systemd.services.fprintd = {
        requires = [ "kait2en-t2-touchid.service" ];
        after = [ "kait2en-t2-touchid.service" ];
        environment.FP_VIRTUAL_DEVICE_STORAGE = "/run/t2-touchid/fprint.sock";
        serviceConfig = {
          ReadWritePaths = [ "/run/t2-touchid" ];
          RuntimeDirectory = "t2-touchid";
          RuntimeDirectoryMode = "0700";
          RuntimeDirectoryPreserve = true;
        };
      };
    })
  ];
}
