-
-Macro.playback.SplitPCM {
-	Name "apple_t2_speakers"
-	Direction Playback
-	Format S24_LE
-	Channels 2
-	HWChannels 2
-	HWChannelPos0 FL
-	HWChannelPos1 FR
-}
-
 SectionVerb {
 	Value {
 		TQ "HiFi"
@@ -25,17 +13,8 @@ SectionDevice."Speaker" {
 
 	Value {
 		PlaybackPriority 100
-	}
-	Macro.pcm_split.SplitPCMDevice {
-		Name "apple_t2_speakers"
-		Direction Playback
-		Device 0
-		Channels 2
-		HWChannels 2
-		Channel0 0
-		Channel1 1
-		ChannelPos0 FL
-		ChannelPos1 FR
+		PlaybackChannels 2
+		PlaybackPCM "hw:${CardId},0"
 	}
 }
 
