+
+/// Whether `err` says the AWDL interface is gone. ENETUNREACH only: the
+/// EADDRNOTAVAIL of an address still running duplicate address detection is
+/// the case the retry loop exists for, and must keep retrying.
+fn awdl_gone(err: &anyhow::Error) -> bool {
+    io_error(err).and_then(std::io::Error::raw_os_error) == Some(libc::ENETUNREACH)
+}
