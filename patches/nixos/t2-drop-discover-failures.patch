+/// Whether `err` is the read timeout of a receiver that accepted the
+/// connection and then never answered.
+fn no_answer(err: &anyhow::Error) -> bool {
+    io_error(err).is_some_and(|e| {
+        matches!(e.kind(), std::io::ErrorKind::WouldBlock | std::io::ErrorKind::TimedOut)
+    })
+}
