#!/bin/sh
if [ "$1" = configure ]; then
    if [ -r /usr/libexec/t2-services/package-actions ]; then
        . /usr/libexec/t2-services/package-actions
        t2_run python3 /usr/libexec/t2-services/lifecycle.py t2-services-common migrate
        migration_status=$t2_last_status
        if [ -d /run/systemd/system ]; then
            t2_run systemctl daemon-reload
            if [ "$migration_status" -eq 0 ]; then
                if [ -z "${2:-}" ] && ! systemctl is-enabled --quiet t2-services-suspend.service; then t2_run systemctl preset t2-services-suspend.service; fi
                : # Never run sleep hooks here
            fi
        fi
        t2_summary
    else
        echo '[t2-services] error: missing lifecycle reporter. Migration skipped' >&2
    fi
fi
#DEBHELPER#
exit 0
